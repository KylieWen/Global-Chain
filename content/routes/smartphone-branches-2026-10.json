  "stepUpdates": {
    "step-raw-materials": [
      "原料从哪里来",
      "锂、钴、镍、石墨、铜和铝相关原料，经过不同加工环节进入电池与电子部件。"
    ],
    "step-materials": [
      "制备正负极材料",
      "正极材料按电池化学体系选用锂、钴、镍等原料；石墨经提纯与改性制成负极材料。"
    ],
    "step-cell": [
      "制造电芯",
      "正极、负极与集流体等组成电芯；电极结构与材料配方随电池类型而变化。"
    ],
    "step-module": [
      "封装电池与管理电路",
      "电芯与保护管理电路、结构件及辅料集成为电池包。韩国与中国的封装路径可分别查看。"
    ],
    "step-assembly": [
      "装成一部手机",
      "主板、屏幕、电池、相机、机身与声学部件在整机阶段汇合。中国、越南与印度展示不同的组装分支。"
    ],
    "step-distribution": [
      "进入零售渠道",
      "成品经分销、运营商与零售渠道进入市场，贸易统计与渠道上市资料分别查看。"
    ],
    "step-consumption": [
      "到达使用者身边",
      "零售市场资料说明手机何时可供购买；进口量、零售销量和最终消费采用各自口径。"
    ],
    "step-component-coverage-gaps": [
      "把相机、电路与机身接起来",
      "镜头、图像传感器与执行器组成相机；电路板连接各系统；机身、声学与触觉部件完成整机功能。"
    ],
    "step-processor-memory-background": [
      "从电路设计到封装芯片",
      "处理器和存储器经过电路设计、晶圆制造及封装测试，再安装到电路板。"
    ]
  },
