  "descriptions": {
    "generic-smartphone": {
      "name": "智能手机",
      "description": "从屏幕、电池和芯片到相机与机身，逐层认识一部智能手机的材料、制造工序与全球分工。研究对象为通用商品，不限定品牌或型号。"
    },
    "battery": {
      "description": "把化学能转成电能，为手机供电。电池包含正负极、电解液和隔膜，并配有管理电路与封装。"
    },
    "display": {
      "description": "把电信号变成图像。面板、驱动电路、触控层与盖板玻璃经过贴合，组成可安装的显示模组。"
    },
    "processor-memory": {
      "description": "处理器执行计算和通信任务；DRAM临时保存运行数据，NAND存储系统与照片。芯片经历设计、晶圆制造、封装测试，再装上电路板。"
    },
    "camera": {
      "description": "镜头聚光，图像传感器把光转成电信号，执行器完成对焦和防抖；这些部件装配并校准为摄像头模组。"
    },
    "pcb-connector": {
      "description": "电路板承载芯片和元件，铜线路负责传送电力与信号；柔性电路和连接器把屏幕、相机、电池与主板连在一起。"
    },
    "enclosure-structure": {
      "description": "金属框架、玻璃或塑料外壳支撑并保护内部组件。材料要经过成形、精密加工、表面处理和装配。"
    },
    "sensor-audio": {
      "description": "麦克风采集声音，扬声器发声，振动马达提供触觉反馈；各类传感器感知运动、距离、光线等状态。"
    },
    "chip-packaging": {
      "name": "封装芯片与测试",
      "description": "把晶圆切出的裸片连接到封装载体，完成保护、互连与电性能测试，形成可安装到电路板的器件。"
    },
    "semiconductor-wafer": {
      "name": "加工后的半导体晶圆",
      "description": "在硅晶圆上反复形成、图案化和连接微小器件，再通过晶圆测试筛选可用裸片。"
    },
    "display-panel": {
      "description": "由发光或液晶像素阵列构成，接收驱动信号生成图像。"
    },
    "display-module": {
      "description": "将面板与驱动电路、柔性连接、触控和保护层集成为屏幕组件。"
    },
    "cover-glass": {
      "description": "覆盖屏幕表面，提供透光、触摸与防护界面。"
    },
    "image-sensor": {
      "description": "由大量感光像素组成，把镜头形成的光学图像转成电子信号。"
    },
    "camera-lens": {
      "description": "利用多片光学镜片收集光线并在图像传感器上成像。"
    },
    "camera-module": {
      "description": "由镜头、图像传感器、对焦/防抖执行器与电路组成，装配后进行光学校准与测试。"
    }
  },
