{
  "name": "globe-chain",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "pnpm --filter @globe-chain/web dev",
    "dev:preview": "node scripts/dev-preview.mjs",
    "data:fetch": "node scripts/fetch-published-sources.mjs",
    "data:fetch:all": "node scripts/fetch-all-published-sources.mjs",
    "data:build:smartphone": "node scripts/build-published-smartphone.mjs",
    "data:rebuild:smartphone": "pnpm run data:fetch:all && pnpm run data:build:smartphone",
    "data:release:list": "node scripts/manage-published-release.mjs list",
    "data:release:verify": "node scripts/manage-published-release.mjs verify",
    "data:release:activate": "node scripts/manage-published-release.mjs activate",
    "data:release:rollback": "node scripts/manage-published-release.mjs rollback",
    "build": "pnpm --filter @globe-chain/web build",
    "start": "pnpm --filter @globe-chain/web start",
    "lint": "pnpm --filter @globe-chain/web lint",
    "typecheck": "pnpm --filter @globe-chain/web typecheck && pnpm --filter @globe-chain/contracts typecheck && pnpm --filter @globe-chain/domain typecheck && pnpm --filter @globe-chain/db typecheck",
    "test": "vitest run"
  },
  "devDependencies": {
    "@globe-chain/contracts": "workspace:*",
    "@globe-chain/db": "workspace:*",
    "@globe-chain/domain": "workspace:*",
    "playwright": "^1.63.0",
    "vitest": "^2.1.9"
  }
}
