{
  "name": "globe-chain",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "pnpm --filter @globe-chain/web dev",
    "build": "pnpm --filter @globe-chain/web build",
    "start": "pnpm --filter @globe-chain/web start",
    "lint": "pnpm --filter @globe-chain/web lint",
    "typecheck": "pnpm --filter @globe-chain/web typecheck && pnpm --filter @globe-chain/contracts typecheck",
    "test": "vitest run"
  },
  "devDependencies": {
    "@globe-chain/contracts": "workspace:*",
    "vitest": "^2.1.9"
  }
}
